# Hostinger Apache/LiteSpeed: only explicitly allowed routes reach public/.
# /ilm-admin needs password; sensitive writes & CSV exports also require TOTP.
Options -Indexes
RewriteEngine On
RewriteCond %{HTTP_HOST} !^gateway\.iluma\.gr$ [NC]
RewriteRule ^ - [R=404,L]

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Reject direct browser requests to the internal public/ front controllers.
RewriteCond %{THE_REQUEST} \s/+public(?:/|\?|\s) [NC]
RewriteRule ^ - [R=404,L]

# Internal rewrite targets only; direct /public/* requests are denied above.
RewriteRule ^public/(?:index\.php|admin\.php|admin\.css|admin\.js)$ - [L]

# Never allow the web to fetch application sources, dotenv, archives or config.
RewriteRule ^(?:src|bin|database|deploy|docs|tests|vendor|private|storage|runtime|logs|backups)(?:/|$) - [R=404,L,NC]
RewriteRule (^|/)\. - [R=404,L]
RewriteRule \.(?:php|phtml|phar|sql|sqlite|json|md|lock|ini|env|log|bak|zip|tar|gz|key|pem|yml|yaml|xml|sh)$ - [R=404,L,NC]

# Protected admin: both /ilm-admin and /ilm-admin/ work.
RewriteRule ^ilm-admin/?$ public/admin.php [L,QSA]
RewriteRule ^ilm-admin/admin\.css$ public/admin.css [L]
RewriteRule ^ilm-admin/admin\.js$ public/admin.js [L]

# Payments API and callbacks (unchanged).
RewriteRule ^(?:api/v1/.+|nexi/(?:staging|production)/notification|checkout/(?:result|cancel))$ public/index.php [L,QSA]

# Neutral 404 for everything else.
RewriteRule ^ - [R=404,L]
