# Never commit deployment environment, local overrides or credentials.
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
*.local
*.local.*
secrets/
private/
credentials/
**/.secrets/
**/.credentials/
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
*.htpasswd
id_rsa*
id_ed25519*

# Dependencies and generated files.
/vendor/
/node_modules/
/coverage/
/build/
/dist/
/.phpunit.cache/
.phpunit.result.cache
.phpunit-watcher.yml
/.php-cs-fixer.cache
/.phpactor.yml

# Runtime data, sensitive logs and local state.
/storage/
/var/
/runtime/
/cache/
/tmp/
/temp/
/logs/
/backups/
*.log
*.log.*
*.pid
*.seed
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.sql.zip
*.dump
*.bak
*.backup
*.swp
*.swo
*.orig
*~

# IDE, editor and operating-system noise.
/.idea/
/.vscode/
/.fleet/
.DS_Store
Thumbs.db
Desktop.ini
*.iml

# Local archives and development exports.
/*.zip
/*.tar
/*.tar.gz
/*.tgz
