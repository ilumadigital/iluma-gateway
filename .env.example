# Set in FPM/worker environment, not inside webroot
APP_ENV=development
GATEWAY_HOST=gateway.iluma.gr
# Admin is hosted on GATEWAY_HOST at /ilm-admin; no separate ADMIN_HOST is needed.
ADMIN_ACCESS_VERIFIED=0
# After penetration test + signed release approval. Production remains blocked otherwise.
PRODUCTION_ENABLED=0
# 32 random bytes encoded as base64; php -r 'echo base64_encode(random_bytes(32)),"\n";'
MASTER_KEY_B64=REPLACE_WITH_32_BYTE_BASE64_KEY
REGISTRY_DSN=mysql:host=127.0.0.1;port=3306;dbname=iluma_registry;charset=utf8mb4
REGISTRY_USER=iluma_registry_user
REGISTRY_PASSWORD=REPLACE
STAGING_DSN=mysql:host=127.0.0.1;port=3306;dbname=iluma_staging;charset=utf8mb4
STAGING_USER=iluma_stage_user
STAGING_PASSWORD=REPLACE
PRODUCTION_DSN=mysql:host=127.0.0.1;port=3306;dbname=iluma_production;charset=utf8mb4
PRODUCTION_USER=iluma_prod_user
PRODUCTION_PASSWORD=REPLACE
NEXI_STAGING_BASE=https://xpaysandbox.nexigroup.com/api/phoenix-0.0/psp
NEXI_PRODUCTION_BASE=https://xpay.nexigroup.com/api/phoenix-0.0/psp
# Both origins must be configured in the reverse proxy and HSTS policy.
IRADIOS_STAGING_WEBHOOK=https://stage.iradios.gr/api/gateway/webhook
IRADIOS_PRODUCTION_WEBHOOK=https://play.iradios.gr/api/gateway/webhook
# Require via VPN/Zero Trust enforced by infrastructure, never trust an unsanitized user header.
