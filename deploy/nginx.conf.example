# VPS-only reference: Hostinger Web/Cloud users use the tracked root .htaccess.
# Terminate TLS correctly; enforce VPN/Zero Trust policy on /ilm-admin*
# BEFORE allowing application admin access. Never enable without edge security.
server {
 listen 443 ssl http2;
 server_name gateway.iluma.gr;
 root /var/www/iluma-gateway/public;
 ssl_certificate /etc/letsencrypt/live/gateway.iluma.gr/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/gateway.iluma.gr/privkey.pem;
 add_header Strict-Transport-Security 'max-age=31536000; includeSubDomains' always;
 client_max_body_size 64k;

 # Protected admin front controller. Gate these paths at the edge.
 location = /ilm-admin {
  include fastcgi_params;
  fastcgi_param SCRIPT_FILENAME $document_root/admin.php;
  fastcgi_pass unix:/run/php/php8.4-fpm.sock;
 }
 location = /ilm-admin/ {
  include fastcgi_params;
  fastcgi_param SCRIPT_FILENAME $document_root/admin.php;
  fastcgi_pass unix:/run/php/php8.4-fpm.sock;
 }
 location = /ilm-admin/admin.css { try_files /admin.css =404; }

 # Payment API, provider webhook and hosted checkout result paths only.
 location ~ ^/(?:api/v1/.+|nexi/(?:staging|production)/notification|checkout/(?:result|cancel))$ {
  include fastcgi_params;
  fastcgi_param SCRIPT_FILENAME $document_root/index.php;
  fastcgi_pass unix:/run/php/php8.4-fpm.sock;
 }
 location / { return 404; }
 location ~ /\. { return 404; }
}
